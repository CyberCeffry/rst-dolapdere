import 'package:flutter/material.dart';

class AppSidebar extends StatelessWidget {
  const AppSidebar({
    super.key,
    required this.selectedIndex,
    required this.onDestinationSelected,
    this.visibleIndices = const [0, 1, 2, 3, 4, 5, 6],
  });

  final int selectedIndex;
  final ValueChanged<int> onDestinationSelected;
  final List<int> visibleIndices;

  static const destinations = <NavigationDestination>[
    NavigationDestination(icon: Icon(Icons.dashboard_outlined), label: 'Panel'),
    NavigationDestination(
      icon: Icon(Icons.location_city_outlined),
      label: 'Alanlar',
    ),
    NavigationDestination(
      icon: Icon(Icons.people_outline),
      label: 'Müşteriler',
    ),
    NavigationDestination(
      icon: Icon(Icons.description_outlined),
      label: 'Sözleşmeler',
    ),
    NavigationDestination(icon: Icon(Icons.history), label: 'Bitenler'),
    NavigationDestination(
      icon: Icon(Icons.notifications_outlined),
      label: 'Bildirimler',
    ),
    NavigationDestination(
      icon: Icon(Icons.settings_outlined),
      label: 'Ayarlar',
    ),
    NavigationDestination(
      icon: Icon(Icons.bookmark_border),
      label: 'Rezervasyonlar',
    ),
  ];

  @override
  Widget build(BuildContext context) {
    // final colors = Theme.of(context).colorScheme;
    return Container(
      width: 240,
      //color: colors.surface,
      child: SafeArea(
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            Padding(
              padding: const EdgeInsets.fromLTRB(20, 24, 16, 22),
              child: Text(
                'RST DOLAPDERE',
                style: TextStyle(
                  color: colors.onSurface,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
            for (final index in visibleIndices)
              ListTile(
                selected: selectedIndex == index,
                selectedTileColor: colors.primary.withValues(alpha: 0.12),
                leading: Icon(
                  destinations[index].icon is Icon
                      ? (destinations[index].icon as Icon).icon
                      : Icons.circle_outlined,
                  color: colors.onSurfaceVariant,
                ),
                title: Text(
                  _labels[index],
                  style: TextStyle(color: colors.onSurface),
                ),
                onTap: () => onDestinationSelected(index),
              ),
          ],
        ),
      ),
    );
  }

  static const _labels = [
    'Ana Panel',
    'Reklam Alanları',
    'Müşteriler',
    'Sözleşmeler',
    'Biten Sözleşmeler',
    'Bildirimler',
    'Ayarlar',
    'Rezervasyonlar',
  ];
}
